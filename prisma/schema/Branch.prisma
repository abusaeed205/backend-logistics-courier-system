model Branch {
  id   String     @id @default(uuid())
  code String     @unique // e.g. "MIRPUR-01", "CUMILLA-HUB"
  name String
  type BranchType

  // Location
  divisionId String
  division   Division @relation(fields: [divisionId], references: [id])

  districtId String
  district   District @relation(fields: [districtId], references: [id])

  upazilaId String
  upazila   Upazila @relation(fields: [upazilaId], references: [id])

  unionId String?
  union   Union?  @relation(fields: [unionId], references: [id])

  address String

  // Branch → Parent Hub/Branch
  parentHubId String?
  parentHub   Branch? @relation("BranchHierarchy", fields: [parentHubId], references: [id])

  childBranches Branch[] @relation("BranchHierarchy")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Branch Staff
  staff BranchStaff[]

  // Riders assigned to this Branch
  riders Rider[]

  // Delivery Zones
  zones DeliveryZone[]
  

  // Parcel relations by role at each Branch

  // এই Branch থেকে যেসব Parcel শুরু হয়েছে
  originParcels Parcel[] @relation("OriginBranch")

  // এই Branch হলো Parcel-এর destination
  destinationParcels Parcel[] @relation("DestinationBranch")

  // বর্তমানে এই Branch-এ থাকা Parcel
  currentLocationParcels Parcel[] @relation("CurrentBranch")

  // এই Branch থেকে যেসব Manifest শুরু হয়েছে
  originManifests Manifest[] @relation("ManifestOriginBranch")

  // এই Branch-এ যেসব Manifest আসবে
  destinationManifests Manifest[] @relation("ManifestDestinationBranch")

  // COD Collection
  payments       Payments[]
  trackingEvents TrackingEvent[]

  @@index([divisionId])
  @@index([districtId])
  @@index([upazilaId])
  @@index([unionId])
  @@index([type])
  @@map("branches")
}
