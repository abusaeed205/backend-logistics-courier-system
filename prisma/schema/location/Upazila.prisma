model Upazila {
  id   String @id @default(uuid())
  name String

  districtId String
  district   District @relation(fields: [districtId], references: [id], onDelete: Restrict)

  unions Union[]

  branches Branch[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([name, districtId])
  @@index([districtId])
  @@map("upazilas")
}
