model Parcel {
  id           String       @id @default(uuid())
  trackingCode String       @unique // customer-facing tracking number

  merchantId String
  merchant   Merchant @relation(fields: [merchantId], references: [id])

  // recipient details captured at parcel-creation time
  recipientName    String
  recipientPhone   String
  recipientAddress String
 

  // Recipient location
 recipientUnionId String?
 recipientUnion   Union? @relation("ParcelRecipientUnion", fields: [recipientUnionId], references: [id])


  parcelType   ParcelType @default(PARCEL)
  weightKg     Decimal    @db.Decimal(6, 2)
  description  String?

  paymentType    PaymentType @default(COD)
  codAmount      Decimal     @default(0) @db.Decimal(10, 2)
  deliveryCharge Decimal     @default(0) @db.Decimal(10, 2)

  currentStatus ParcelStatus @default(PICKUP_REQUESTED)

  // route endpoints
  originBranchId      String?
  originBranch        Branch? @relation("OriginBranch", fields: [originBranchId], references: [id])
  destinationBranchId String?
  destinationBranch   Branch? @relation("DestinationBranch", fields: [destinationBranchId], references: [id])

  // where the parcel physically is right now (nullable while with a rider/in transit)
  currentBranchId String?
  currentBranch   Branch? @relation("CurrentBranch", fields: [currentBranchId], references: [id])

  pickupRiderId String?
  pickupRider   Rider?  @relation("PickupRider", fields: [pickupRiderId], references: [id])

  deliveryRiderId String?
  deliveryRider   Rider?  @relation("DeliveryRider", fields: [deliveryRiderId], references: [id])

  deliveryAttempts Int @default(0)
  lastFailureReason DeliveryFailureReason?
  deliveredAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  trackingEvents TrackingEvent[]
  manifestItems  ManifestParcel[]
  payments  Payments?
  ledgerEntry    MerchantLedgerEntry?

  @@index([merchantId])
  @@index([currentStatus])
  @@index([trackingCode])
  @@map("parcels")
}
